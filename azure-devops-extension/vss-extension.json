{
  "manifestVersion": 1,
  "id": "etalii-spec-kit-ad",
  "publisher": "vrenken",
  "version": "0.1.0",
  "name": "Etalii Spec Kit",
  "description": "Spec-driven development with agents and people on one Azure DevOps backlog: chat with a model to specify, break down, refine or analyse a work item, and apply the result.",
  "public": false,
  "categories": [
    "Azure Boards"
  ],
  "targets": [
    {
      "id": "Microsoft.VisualStudio.Services"
    }
  ],
  "scopes": [
    "vso.work_write"
  ],
  "content": {
    "details": {
      "path": "README.md"
    }
  },
  "files": [
    {
      "path": "dist",
      "addressable": true
    }
  ],
  "contributions": [
    {
      "id": "work-item-menu",
      "type": "ms.vss-web.action",
      "description": "Opens the Etalii Spec Kit chat for a work item",
      "targets": [
        "ms.vss-work-web.work-item-context-menu",
        "ms.vss-work-web.backlog-item-menu",
        "ms.vss-work-web.backlog-board-card-item-menu",
        "ms.vss-work-web.work-item-toolbar-menu"
      ],
      "properties": {
        "text": "Etalii Spec Kit",
        "title": "Work on this item's specification with a model",
        "group": "contributed",
        "uri": "dist/menu.html",
        "registeredObjectId": "etalii-spec-kit-menu"
      }
    },
    {
      "id": "chat-panel",
      "type": "ms.vss-web.external-content",
      "description": "Chat with a model about one work item and apply the result",
      "targets": [],
      "properties": {
        "uri": "dist/chat.html"
      }
    }
  ]
}
